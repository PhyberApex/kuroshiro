KUROSHIRO_DB_HOST=localhost
KUROSHIRO_DB_PORT=5432
KUROSHIRO_DB_USER=root
KUROSHIRO_DB_PASSWORD=root
KUROSHIRO_DB_DB=test
KUROSHIRO_PORT=3000
KUROSHIRO_API_URL=http://{YOUR_IP}
# Uncomment to enable Alert notifications via an apprise-api sidecar (see docker-compose.yml).
# KUROSHIRO_APPRISE_URL=http://apprise-api:8000
# KUROSHIRO_APPRISE_KEY=kuroshiro
# KUROSHIRO_ALERT_LOW_BATTERY_PERCENT=20
# KUROSHIRO_ALERT_OFFLINE_MULTIPLIER=3
# KUROSHIRO_ALERT_FETCH_FAILURES=3
# KUROSHIRO_ALERT_REMINDER_HOURS=0
# KUROSHIRO_ALERT_RETENTION_DAYS=90
# KUROSHIRO_DEVICE_LOG_RETENTION_DAYS=30
# Host names, IP addresses and CIDR ranges a Screen's Template may request though they are
# private; every other internal host is refused. 0.0.0.0/0,::/0 allows the whole network.
# KUROSHIRO_RENDER_ALLOWED_HOSTS=homeassistant.local,192.168.1.0/24
# For a public demo instance, or to try Kuroshiro furnished rather than empty: refuses file
# uploads and fetches from private addresses, and seeds the showcase Configuration Archive
# (ADR-0042) on a boot against an empty database.
# KUROSHIRO_DEMO_MODE=false

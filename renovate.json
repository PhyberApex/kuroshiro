{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "security:minimumReleaseAgeNpm"
  ],
  "packageRules": [
    {
      "description": "Minor and patch updates merge themselves once the required checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/shared/src/screen-shell\\.ts$/"],
      "matchStrings": ["TRMNL_FRAMEWORK_VERSION = '(?<currentValue>[^']+)'"],
      "depNameTemplate": "usetrmnl/trmnl-framework",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ]
}

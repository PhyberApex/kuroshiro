{
  "name": "kuroshiro",
  "version": "0.11.0",
  "packageManager": "pnpm@11.23.0",
  "description": "",
  "author": "Janis Walliser",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "vue",
    "TRMNL",
    "BYOS"
  ],
  "main": "index.js",
  "scripts": {
    "dev": "dotenv -- concurrently -k -n FRONTEND,BACKEND -c blue,green \"pnpm run dev:ui\" \"pnpm run dev:api\"",
    "dev:api": "pnpm --filter ./packages/api start:dev",
    "dev:ui": "wait-on tcp:3000 && pnpm --filter ./packages/ui dev",
    "format": "pnpm run -r lint:fix",
    "test": "pnpm run -r test",
    "test:coverage": "pnpm run -r test:coverage",
    "lint": "pnpm run -r lint",
    "lint:fix": "pnpm run -r lint:fix",
    "type-check": "pnpm run -r type-check",
    "build": "pnpm run -r type-check",
    "fallow": "fallow",
    "fallow:ci": "fallow dead-code --baseline .fallow-baselines/dead-code.baseline.json --fail-on-issues && fallow dupes --baseline .fallow-baselines/dupes.baseline.json --fail-on-issues && fallow health --baseline .fallow-baselines/health.baseline.json --fail-on-issues",
    "fallow:baseline": "node scripts/fallow-baseline.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "dotenv-cli": "^11.0.0",
    "fallow": "3.18.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "wait-on": "9.1.0"
  }
}

{
  "name": "kuroshiro-ui",
  "type": "module",
  "version": "0.17.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:screenshots": "node scripts/screenshots.mjs",
    "test:screenshots:update": "node scripts/screenshots.mjs --update",
    "test:real-api": "vitest run --config vitest.real-api.config.ts",
    "showcase:screenshots": "vitest run --config vitest.showcase.config.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-html": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/lang-json": "catalog:",
    "@codemirror/lang-liquid": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@fontsource-variable/archivo": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@lezer/highlight": "catalog:",
    "reka-ui": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/tsconfig": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "kuroshiro-shared": "workspace:*",
    "msw": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
